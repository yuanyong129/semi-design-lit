{
  "name": "semi-design-lit-monorepo",
  "description": "Semi Design Lit Monorepo - Lit web components following Semi Design",
  "private": true,
  "scripts": {
    "dev:docs": "pnpm -F @semi-design/semi-lit-docs dev",
    "build:docs": "pnpm -F @semi-design/semi-lit-docs build",
    "build:component": "pnpm --filter @semi-design/web-lit run build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "workspaces": [
    "packages/*"
  ],
  "author": "Semi Design Lit contributors",
  "license": "MIT"
}

{
  "name": "@arco-design/web-lit",
  "version": "0.0.1",
  "type": "module",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icon": {
      "import": "./dist/icon.js",
      "require": "./dist/icon.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanyong129/arco-design-lit.git"
  },
  "dependencies": {
    "@arco-design/color": "^0.4.0",
    "@lit-labs/signals": "^0.1.2",
    "@lit/context": "^1.1.4",
    "dayjs": "^1.11.13",
    "lit": "^3.2.1",
    "resize-observer-polyfill": "^1.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.0.7"
  }
}
